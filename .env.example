# Скопировать в .env и заполнить. .env в репозиторий не попадает.

# --- Telegram ---
# Токен у @BotFather, chat_id — у @userinfobot
TELEGRAM_BOT_TOKEN=
# Основной чат: туда уходит первая команда из TEAM_ID и туда шлёт одиночный
# режим, если подписчиков ещё нет.
TELEGRAM_CHAT_ID=

# Кому ещё разрешено пользоваться ботом. Свой chat_id можно узнать, написав
# боту /whoami (или у @userinfobot). У групп id отрицательный — это нормально.
# Каждый разрешённый аккаунт ведёт СВОЙ список команд через /track.
TELEGRAM_ALLOWED_CHATS=

# Отвечать только тем, кто перечислен выше. Выключать только осознанно: у бота
# публичный адрес, и без белого списка команду ему отдаст кто угодно.
TELEGRAM_WHITELIST_ONLY=true

# --- Образ ---
# Какой образ тянуть. Зависит от логина Docker Hub, под которым публикует CI:
# точное имя печатается в сводке прогона («Опубликовано»). Вместо latest можно
# прибиться к версии: ваш-логин/hltv-notificator:0.1.0-build.42
IMAGE=ваш-логин/hltv-notificator:latest

# --- Режим ---
# Пока true, уведомления пишутся в лог вместо отправки. Первый прогон
# на реальном матче делать только так.
DRY_RUN=true
LOG_LEVEL=INFO
TZ_DISPLAY=Europe/Moscow
DB_PATH=data/hltv.db

# --- Отслеживаемая команда ---
TEAM_ID=12857
TEAM_SLUG=forze-reload
TEAM_NAME=FORZE Reload

# --- Частоты опроса, секунды (см. docs/operations.md) ---
# Потолок 1 запрос / 30 сек зашит в код и этими значениями не поднимается.
POLL_IDLE_SECONDS=1800
POLL_PREMATCH_SECONDS=180
POLL_LIVE_SECONDS=60
POLL_LIVE_WITH_FEED_SECONDS=300
PREMATCH_WINDOW_MINUTES=30

# --- Живое сообщение со счётом по ходу карты ---
# Одно сообщение на карту, обновляется через editMessageText. Telegram не
# любит частых правок: реже 5 секунд не ставить.
LIVE_MESSAGE=true
LIVE_EDIT_SECONDS=10

# Пауза после 403 на живом фиде. Всё это время сервис живёт опросом страницы
# матча. Ниже 60 секунд не опускается — потолок зашит в код.
LIVE_FEED_COOLDOWN_SECONDS=600

# --- Напоминания перед матчем ---
# За сколько минут напоминать. Значения по умолчанию для НОВОГО подписчика,
# дальше он правит их сам командой /remind. Несколько — через запятую.
REMINDERS=15

# --- Хранение истории ---
# Отправленные строки очереди — мусор, их можно чистить смело. Журнал событий
# трогаем осторожнее: он и есть защита от повторной рассылки.
OUTBOX_KEEP_DAYS=90
EVENTS_KEEP_DAYS=365

# --- Мультикиллы ---
# Алерт, когда игрок ОТСЛЕЖИВАЕМОЙ команды берёт N фрагов за раунд. Приходит в
# момент N-го фрага, а не в конце раунда. Отдельно сообщается эйс.
MULTIKILL_ALERTS=true
MULTIKILL_THRESHOLD=4

# --- Тревога о деградации ---
# Через сколько сообщать, что сервис ослеп. В срочных ситуациях порог всегда
# минута: до старта матча меньше минуты, кому-то осталось три раунда до победы
# на карте, идёт овертайм. Максимум 600.
DEGRADED_ALERT_SECONDS=300

# --- Пороги событий ---
E2_MIN_SHIFT_MINUTES=5
E2_DEBOUNCE_MINUTES=10
STALE_MINUTES=15

# --- HTTP ---
HTTP_IMPERSONATE=chrome
HTTP_RETRIES=3
FAILURES_BEFORE_ALERT=3
RAW_LOG_DAYS=7

# --- Прокси (необязательно) ---
# Стандартные имена, свои переменные для этого не заводятся. Схемы: http://,
# https://, socks5://, socks5h:// (у socks5h имя резолвит прокси — обычно
# именно это и нужно, чтобы выйти из закрытой сети).
#
# Верхний регистр работает: libcurl сам HTTP_PROXY в верхнем регистре
# игнорирует, но сервис читает переменные до него и передаёт явно.
#
# HTTP_PROXY=http://192.168.1.10:20171
# HTTPS_PROXY=http://192.168.1.10:20171
# ALL_PROXY=socks5h://192.168.1.10:20170
# NO_PROXY=localhost,127.0.0.1,192.168.1.0/24

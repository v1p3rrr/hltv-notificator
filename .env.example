# Copy to .env and fill in. .env never enters the repository.

# --- Telegram ---
# The token comes from @BotFather.
TELEGRAM_BOT_TOKEN=

# Who may use the bot. One variable, ids SEPARATED BY COMMAS:
#   TELEGRAM_CHAT_ID=123456789,987654321,-1001234567890
# The first one is the main chat: the team from TEAM_ID is seeded there on the
# first run, and single-user mode sends there while there are no subscribers.
# Every allowed account keeps ITS OWN team list through /track.
# A person learns their own id from @userinfobot; the bot itself answers
# /whoami only to chats that are already allowed.
# For groups and channels the id is negative — that is normal.
TELEGRAM_CHAT_ID=

# Answer only those listed above. Turn this off only deliberately: the bot has
# a public address, and without the whitelist anyone could command it.
TELEGRAM_WHITELIST_ONLY=true

# Commands one chat may send per minute; 0 is off. With the whitelist on,
# whoever can reach the bot is somebody you chose, so this is meant for the
# open mode. Over the limit the bot says so once and then stays quiet.
COMMAND_RATE_LIMIT=0

# --- Image ---
# Which image to pull. Leave it commented out to use the published one,
# vprlol/hltv-notificator:latest (linux/amd64). Set it to pin a version, or to
# point at an image you publish yourself:
# IMAGE=vprlol/hltv-notificator:0.1.0-build.42

# --- Mode ---
# While this is true, notifications go to the log instead of being sent. The
# first run against a real match should only be done this way.
DRY_RUN=true
LOG_LEVEL=INFO
TZ_DISPLAY=Europe/Moscow
DB_PATH=data/hltv.db

# --- The tracked team ---
TEAM_ID=12857
TEAM_SLUG=forze-reload
TEAM_NAME=FORZE Reload

# How many teams one person may follow. This is the setting that decides
# whether the service keeps up: a schedule sweep reads one page per DISTINCT
# team and the ceiling is one request per 30 s, so ten teams already mean a
# five-minute sweep against the three minutes pre-match mode would like.
# Raise it only if you accept every team being looked at less often.
# 0 removes the limit.
MAX_TEAMS_PER_SUBSCRIBER=10

# --- Polling intervals, seconds (see docs/operations.md) ---
# The ceiling of 1 request / 30 s is hardcoded and these values cannot raise it.
POLL_IDLE_SECONDS=1800
POLL_PREMATCH_SECONDS=180
POLL_LIVE_SECONDS=60
POLL_LIVE_WITH_FEED_SECONDS=300
PREMATCH_WINDOW_MINUTES=30
# A match whose time has come but which has not started keeps the frequent
# polling for this long. That is the window in which HLTV moves it — by five
# minutes, then ten — and the only way to catch such a move is to keep looking.
LATE_START_GRACE_MINUTES=60

# --- The live score message during a map ---
# One message per map, updated through editMessageText. Telegram dislikes
# frequent edits: do not set this below 5 seconds.
LIVE_MESSAGE=true
LIVE_EDIT_SECONDS=10
# How many card edits a second the service allows itself IN TOTAL. The card
# is one message per subscriber, so its cost grows with the audience while
# Telegram's budget does not: at this setting a hundred people still get the
# interval above, three hundred get thirty seconds instead of ten. A card
# that updates more slowly is honest; one stuck on an old score is not.
# 0 removes the adjustment.
LIVE_EDIT_BUDGET=10

# The pause after a 403 on the live feed. Throughout it the service lives on
# match-page polling. It never goes below 60 seconds — that floor is hardcoded.
LIVE_FEED_COOLDOWN_SECONDS=600

# --- Pre-match reminders ---
# How many minutes before to remind. These are the defaults for a NEW
# subscriber; after that they edit them with /remind. Several, comma separated.
REMINDERS=15

# --- History retention ---
# Sent queue rows are rubbish and can be pruned freely. The event journal is
# treated more carefully: it is the protection against re-sending.
OUTBOX_KEEP_DAYS=90
EVENTS_KEEP_DAYS=365

# --- Multikills ---
# An alert when a player of a TRACKED team takes N kills in a round. It arrives
# at the Nth kill, not at the end of the round. An ace is reported separately.
MULTIKILL_ALERTS=true
MULTIKILL_THRESHOLD=4
# Alert on the half (12 rounds played) and on the start of every overtime
# (12-12, 15-15, ...). Off by default: the live card shows all of it anyway.
PHASE_ALERTS=false

# How big a swing in the score difference counts as a comeback, reported as
# one extra line on the map result. Not a streak: 3:11 -> 13:11 and
# 1:7 -> 13:9 are both swings of ten, and only the first is a streak.
# 0 removes the line.
COMEBACK_ROUNDS=9

# --- The degradation alarm ---
# How long before reporting that the service has gone blind. In urgent
# situations the threshold is always a minute: under a minute to the match
# start, someone three rounds from winning a map, an overtime running. Max 600.
DEGRADED_ALERT_SECONDS=300

# --- Event thresholds ---
# A shift smaller than this is accepted silently; a bigger one waits out the
# debounce window, so that a burst of edits collapses into one message. The
# window never runs past the start though: with less than E2_DEBOUNCE_MINUTES
# to the match the reschedule goes out at once, and once the new time has
# passed it is not sent at all.
E2_MIN_SHIFT_MINUTES=5
E2_DEBOUNCE_MINUTES=10
STALE_MINUTES=15

# --- HTTP ---
HTTP_IMPERSONATE=chrome
HTTP_RETRIES=3
FAILURES_BEFORE_ALERT=3
RAW_LOG_DAYS=7

# --- Proxy (optional) ---
# Standard names; no custom variables are introduced for this. Schemes:
# http://, https://, socks5://, socks5h:// (with socks5h the proxy resolves the
# name — usually what you want to get out of a closed network).
#
# Uppercase works: libcurl itself ignores uppercase HTTP_PROXY, but the service
# reads the variables before it does and passes them explicitly.
#
# HTTP_PROXY=http://192.168.1.10:20171
# HTTPS_PROXY=http://192.168.1.10:20171
# ALL_PROXY=socks5h://192.168.1.10:20170
# NO_PROXY=localhost,127.0.0.1,192.168.1.0/24
